# vectra configuration. Copy to ~/.config/vectra/.env; never commit a real .env.
# Environment variables with the same names override values in that file.

# Where vectra keeps its data, including the vector index (default: $XDG_DATA_HOME/vectra).
# VECTRA_DATA_DIR=~/.local/share/vectra

# Embedding model (a collection keeps the model and dimension it was created with).
# VECTRA_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
# VECTRA_EMBEDDING_DIMENSION=384

# Extra attempts per file during `vectra sync` (default 2, minimum 0).
# VECTRA_SYNC_MAX_RETRIES=2
